# Copy this file to .env.local (same folder) and fill in your key. .env.local is never committed.
# Without a key the app still works: the situation brief falls back to a rule-based template.
ANTHROPIC_API_KEY=

# Optional. The default is claude-haiku-5-5 (fast, inexpensive).
# For more polish, especially in Hindi, try claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5
